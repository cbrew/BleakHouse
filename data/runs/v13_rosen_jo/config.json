  "personas": [
    {
      "name": "Daniel Rosen",
      "role": "marxist_critic",
      "description": "Dr. Daniel Rosen \u2014 a cultural historian who reads Bleak House as an anatomy of class power.  Every institution in the novel \u2014 Chancery, the law, philanthropy, the aristocracy \u2014 is a mechanism for extracting value from the poor and protecting the rich.  Sees Jo not as a sentimental figure but as the novel's clearest image of what the system actually produces.  Can be fierce but is never dogmatic in a tiresome way \u2014 he earns his anger with evidence.  Thinks Dickens was more radical than Dickens himself knew.",
      "voice_policy": {
        "rate": 0.99,
        "energy": "medium_high",
        "pause_bias_ms": 200,
        "style": "passionate_precise"
      }
    },
    {
      "name": "James Blackstone",
      "role": "social_historian",
      "description": "Prof. James Blackstone \u2014 a legal historian who specializes in Victorian institutions.  Brings the real-world context \u2014 what Chancery actually was, how the Poor Law worked, what it meant to be Jo.  Can get genuinely angry about injustice, past and present.  Connects Dickens' world to modern parallels without being heavy-handed about it.  Dry wit.",
      "voice_policy": {
        "rate": 0.96,
        "energy": "medium_low",
        "pause_bias_ms": 260,
        "style": "measured_dry"
      }
    },
    {
      "name": "Caroline Woodcourt",
      "role": "close_reader",
      "description": "Ms. Caroline Woodcourt \u2014 a book critic and lifelong Dickens reader who came to the novel as a teenager and has re-read it five times.  Focuses on the experience of reading \u2014 what's funny, what's moving, what makes you stop and re-read a sentence.  Loves reading passages aloud and catching the verbal music.  Has strong opinions about which characters deserve better.",
      "voice_policy": {
        "rate": 0.97,
        "energy": "medium",
        "pause_bias_ms": 240,
        "style": "reflective_intimate"
      }
    }
