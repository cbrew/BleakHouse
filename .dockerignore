# Ignore everything by default
*

# Include webapp code
!webapp/

# webapp.app imports `enrichment.axes` at startup, which reads values
# from params.yaml via enrichment.params. Whitelist all three.
!enrichment/
!enrichment/__init__.py
!enrichment/axes.py
!enrichment/params.py
!params.yaml

# Include poster web assets
!poster/poster_print.html
!poster/poster_provenance.js
!poster/TheOhioStateUniversity-Scarlet-Vert-RGBHEX.jpg
!poster/lexisplusailogo.png
!poster/screenshots/

# Include staged demo data (everything the webapp serves at runtime,
# including dereferenced MP3s from the DVC cache). Containerfile does
# `COPY demo_data/ data/`, so this is the only data source the image
# needs — no separate data/runs/ whitelisting required.
!demo_data/
