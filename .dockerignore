# Ignore everything by default
*

# Include what the container needs
!webapp/
!data/runs/ext_v01_baseline/audio/
!data/runs/ext_v19_all_swapped/audio/
!data/runs/motf_ext_v01_baseline/audio/
!data/runs/motf_ext_v19_all_swapped/audio/

# Exclude segment-only audio (keep full podcast + manifest only)
data/runs/*/audio/podcast_segment_*.mp3
