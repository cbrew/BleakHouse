# Ignore everything by default; whitelist exact build inputs.
*

# Application code.
!webapp/
!webapp_v2/
!cas/
!enrichment/__init__.py
!enrichment/axes.py
!enrichment/params.py
!enrichment/expdb/
!scripts/generate_runs_yaml.py

# v2 baked data (content.db). Whitelist this single file inside an
# otherwise-ignored data/ tree.
!data/
data/*
!data/content.db

# Pipeline declarations. (dvc.yaml/dvc.lock retired in BleakHouse-zmlw.)
!params.yaml
!runs.yaml

# Pre-baked data tarball (built by scripts/deploy_demo.sh from the
# dvc-pulled local cache; tarred with -h so symlinks are dereferenced
# into regular files; deleted post-deploy by the script).
!data-runs.tar

# Poster + static assets.
!poster/poster_print.html
!poster/poster_provenance.js
!poster/TheOhioStateUniversity-Scarlet-Vert-RGBHEX.jpg
!poster/lexisplusailogo.png
