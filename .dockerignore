# Ignore everything by default; whitelist exact build inputs.
*

# Python deps + project metadata.
!pyproject.toml
!uv.lock

# Application code.
!webapp/
!enrichment/__init__.py
!enrichment/axes.py
!enrichment/params.py
!enrichment/expdb/

# Scripts the entrypoint + image build need.
!scripts/generate_runs_yaml.py
!scripts/container-entrypoint.sh

# Pipeline declarations + runs index + params.
!params.yaml
!runs.yaml
!dvc.yaml
!dvc.lock

# Committed DVC config (R2 remote name only; secrets injected at runtime
# via .dvc/config.local generated by the entrypoint).
!.dvc/
.dvc/cache/
.dvc/config.local
.dvc/tmp/

# Stays-in-git per-run files (config.json + run_manifest.json) only.
# Other files under data/runs/ are DVC-managed symlinks pointing at the
# Mac-local cache; the entrypoint's `dvc pull` re-materialises them
# inside the container. We deliberately do NOT bring symlinks into the
# build context — they'd be broken.
!data/runs/
data/runs/**/audio/
data/runs/**/phase0_segments.json
data/runs/**/phase1_assignments.json
data/runs/**/phase2_plan.json
data/runs/**/phase2_5_host_briefs.json
data/runs/**/phase2_5_interviews.json
data/runs/**/phase2_5_timings.json
data/runs/**/phase2_5_reading_list.json
data/runs/**/phase3_episode.json
data/runs/**/phase3_teaser.json
data/runs/**/phase_timings.json
data/runs/**/embedding_artifacts.json
data/runs/**/quote_verification.json
data/runs/**/manifest.json
data/runs/**/report.html
data/runs/**/retrofit_manifest.json

# Poster + static assets.
!poster/poster_print.html
!poster/poster_provenance.js
!poster/TheOhioStateUniversity-Scarlet-Vert-RGBHEX.jpg
!poster/lexisplusailogo.png
!poster/screenshots/
