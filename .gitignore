.env
__pycache__/
*.pyc
.venv/

# forced_align tool's separate venv + lock (never deployed; lock varies by host).
tools/forced_align/.venv/
tools/forced_align/uv.lock
data/bleak_house_vectors/
data/novels/*/vectors/
data/novels/*/images/
data/novels/*/*.zip
data/novels/*/*.png
data/novels/*/*.html
.idea/

# Dolt database files (added by bd init)
.dolt/
*.db
data/tts_models/

# Rendered audio — GitHub warns at 50MB; large MP3s stay local-only.
# Bytes live in the local CAS (data/cas/) and on R2.
data/runs/**/audio/*.mp3
data/runs/**/audio/*.wav
data/runs/**/audio/*.m4a
data/runs/**/audio/shards/**/*.mp3

# Local content-addressed store. Populated by enrichment/render_audio.py
# (per-shard cas.put) and scripts/cas_absorb_working_tree.py (one-shot
# migration). Bytes are addressed by md5; canonical copy lives on R2.
data/cas/

# Per-run human-readable reports — pure derived output of
# webapp/build_report.py from phase3_episode.json + manifest.json.
# Nothing reads them as input; regeneratable on demand.
data/runs/**/report.html
data/runs/**/report.txt

# Pipeline-output JSON used to be DVC-tracked (working-tree symlinks
# into .dvc/cache, canonical bytes on R2). Post-CAS migration
# (BleakHouse-zmlw) the JSON outputs live in git directly — the
# entire data/runs/<run>/ tree EXCEPT audio mp3s + reports + archives
# (handled below) is committed. The "sub-optimal but acceptable"
# approach the user signed off on; revisit when repo size becomes
# painful.

# Per-speaker clip pools (regenerable scratch from scripts/build_voice_pool.py).
# The curated, designed reference clips at data/voice_refs/ ARE tracked.
data/voice_pools/

# Scratch output from a one-off transport solver invocation
# (enrichment/transport_podcast.py main path). Real pipeline runs
# write their phase1_assignments.json into data/runs/<run>/, not here.
data/transport_assignments.json

# Reference-verification SQLite cache. Populated by
# enrichment/reference_verify.py to skip redundant HEAD checks across
# runs. Disposable; regenerates on demand.
data/reference_verify_cache.sqlite3

# Evaluation harness probe outputs. Produced by scripts/run_eval_*.py
# and scripts/structured_output_review.py against fixtures, not by
# the production pipeline.
data/eval/

# Backup files left behind by one-shot data migrations
# (e.g. scripts/migrate_overcap_enrichments.py, the prior fix that
# capped over-long list-Literal outputs). Once the migration is
# verified, the .pre_*_migration siblings are disposable.
data/novels/*/passages_enriched.json.pre_*_migration

# Experiment ledger (regenerable from data/runs via `python -m enrichment.expdb scan`).
data/experiments.db
data/experiments.db-wal
data/experiments.db-shm
data/content.db-wal
data/content.db-shm

# Refverify source-tool cache (regenerable; 30-day TTL).
.cache/

# Superpowers brainstorming session artefacts (mockups + state per session).
.superpowers/

# Archived/snapshotted run dirs — kept locally for reference but not
# tracked in the repo (a clean clone would otherwise pull ~160MB of
# frozen pre-refactor artefacts).
data/runs_archived_*/
# data/runs/_archive/ removed from the repo 2026-05-03; backup at
# /Volumes/Crucial X9/bleakhouse_archive_backup_2026-05-03/_archive/.
# Pattern stays so a future restore-and-experiment doesn't accidentally
# re-track 386 MB.
data/runs/_archive/

# Legacy top-level data files from the pre-multi-novel architecture.
# The live equivalents live under data/novels/<key>/. These were
# Bleak-House-only and untracked 2026-05-02; the gitignore lines stop
# them re-appearing if some legacy script is run from data/.
/data/batch_manifest.json
/data/character_arcs.json
/data/contexts.json
/data/passages_raw.json
/data/passages_contextual.json
/data/pg*-images.html
/data/podcast_episode.json
/data/segment_plan.json

# Beads / Dolt files (added by bd init)
.beads-credential-key

# === macOS / IDE / local debris ===
.DS_Store
.claude/scheduled_tasks.lock
.claude/settings.local.json
.playwright-mcp/

# === Per-run pipeline log directory (regenerable; not part of run artifacts) ===
data/runs/_logs/

# === TTS audio cache (regenerable; ~5k files) ===
data/tts_cache/

# === Demo bundle staging (regenerable from scripts/deploy_demo.sh) ===
demo_data/

# === Poster build artifacts (poster.tex / poster.html stay tracked) ===
poster/.DS_Store
poster/*.aux
poster/*.log
poster/*.nav
poster/*.out
poster/*.snm
poster/*.toc
poster/*.blg
poster/*.bbl
poster/beamerposter.pdf
poster/screenshots/
poster/workspace/node_modules/
poster/workspace/preview*.png
poster/test_noimages.log

# === Paper LaTeX build artifacts (.tex / .bib / .pdf stay tracked) ===
paper/*.aux
paper/*.bbl
paper/*.bcf
paper/*.blg
paper/*.log
paper/*.out
paper/*.run.xml
paper/iccc_template/
paper/jtdh_template/
paper/jtdh_template.zip
paper/iccc-author-kit-2022.zip
paper/coe-research poster_2021-12.html
paper/coe-research poster_2021-12_files/
paper/generalization_plan.docx
paper/generalization_plan.js

# === reports/ LaTeX build artifacts (.tex / .pdf / .bib stay tracked) ===
reports/*.aux
reports/*.bbl
reports/*.blg
reports/*.log
reports/*.out

# === Per-task timestamped reports (top-level reports/ only) ===
# Generated by the "before/after every task" tooling; pattern is
# <family>_<YYYYMMDD>_<HHMMSS>_<git-hash>.<ext>. archived_v2/ and other
# named subdirs are NOT covered — they are curated snapshots.
reports/*_20[0-9][0-9][0-9][0-9][0-9][0-9]_[0-9][0-9][0-9][0-9][0-9][0-9]_*.txt
reports/*_20[0-9][0-9][0-9][0-9][0-9][0-9]_[0-9][0-9][0-9][0-9][0-9][0-9]_*.png
reports/*_20[0-9][0-9][0-9][0-9][0-9][0-9]_[0-9][0-9][0-9][0-9][0-9][0-9]_*.html

# === Repo-root scratch (dev screenshots, LaTeX intermediates, test mp3) ===
/*.png
/*.aux
/*.log
/*.out
/beamerposter.pdf
/test_segment0.mp3
/texput.log
