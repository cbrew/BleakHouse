.env
__pycache__/
*.pyc
.venv/
data/bleak_house_vectors/
data/novels/*/vectors/
data/novels/*/images/
data/novels/*/*.zip
data/novels/*/*.png
data/novels/*/*.html
.idea/

# Dolt database files (added by bd init)
.dolt/
*.db
data/tts_models/

# Rendered audio — GitHub warns at 50MB; large MP3s stay local-only.
# Shared audio lives on the external PODCAST_AUDIO_DIR volume.
data/runs/**/audio/*.mp3
data/runs/**/audio/*.wav
data/runs/**/audio/*.m4a

# Per-run human-readable reports — pure derived output of
# webapp/build_report.py from phase3_episode.json + manifest.json.
# Nothing reads them as input; regeneratable on demand.
data/runs/**/report.html
data/runs/**/report.txt

# Pipeline-output JSON migrated from in-tree git storage to DVC cache + R2
# remote (BleakHouse-1dnv Phase 1+). Working-copy files are symlinks into
# .dvc/cache; canonical content lives in R2. `dvc pull` reconstructs after
# a fresh clone.
data/runs/**/phase3_episode.json
data/runs/**/phase3_teaser.json
data/runs/**/embedding_artifacts.json
data/runs/**/audio/manifest_qwen.json
data/runs/**/audio/manifest_trevelyan_v2.json
data/runs/**/phase2_5_host_briefs.json
data/runs/**/phase2_5_interviews.json
data/runs/**/phase2_5_timings.json
data/runs/**/phase2_5_reading_list.json
# Use single-* (not **) for top-level run-dir files so the pattern
# doesn't accidentally catch nested files like data/runs/X/audio/manifest.json.
data/runs/*/manifest.json
data/runs/*/quote_verification.json
data/runs/*/run_manifest.json
data/runs/*/phase0_segments.json
data/runs/*/phase1_assignments.json
data/runs/*/phase2_plan.json

# Per-speaker clip pools (regenerable scratch from scripts/build_voice_pool.py).
# The curated, designed reference clips at data/voice_refs/ ARE tracked.
data/voice_pools/

# Experiment ledger (regenerable from data/runs via `python -m enrichment.expdb scan`).
data/experiments.db
data/experiments.db-wal
data/experiments.db-shm

# Refverify source-tool cache (regenerable; 30-day TTL).
.cache/

# Archived/snapshotted run dirs — kept locally for reference but not
# tracked in the repo (a clean clone would otherwise pull ~160MB of
# frozen pre-refactor artefacts).
data/runs_archived_*/

# Legacy top-level data files from the pre-multi-novel architecture.
# The live equivalents live under data/novels/<key>/. These were
# Bleak-House-only and untracked 2026-05-02; the gitignore lines stop
# them re-appearing if some legacy script is run from data/.
/data/batch_manifest.json
/data/character_arcs.json
/data/contexts.json
/data/passages_raw.json
/data/passages_contextual.json
/data/pg*-images.html
/data/podcast_episode.json
/data/segment_plan.json
