.env
__pycache__/
*.pyc
.venv/
data/bleak_house_vectors/
data/novels/*/vectors/
data/novels/*/images/
data/novels/*/*.zip
data/novels/*/*.png
data/novels/*/*.html
.idea/

# Dolt database files (added by bd init)
.dolt/
*.db
data/tts_models/

# Rendered audio — GitHub warns at 50MB; large MP3s stay local-only.
# Shared audio lives on the external PODCAST_AUDIO_DIR volume.
data/runs/**/audio/*.mp3
data/runs/**/audio/*.wav
data/runs/**/audio/*.m4a

# Per-speaker clip pools (regenerable scratch from scripts/build_voice_pool.py).
# The curated, designed reference clips at data/voice_refs/ ARE tracked.
data/voice_pools/

# Experiment ledger (regenerable from data/runs via `python -m enrichment.expdb scan`).
data/experiments.db
data/experiments.db-wal
data/experiments.db-shm
