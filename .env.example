# BleakHouse — environment template.
#
# Copy to `.env` (gitignored) and fill in values. Loaded by python-dotenv
# at module top in scripts that need credentials (cas, render_audio,
# pipeline entry points).
#
# Convention: `.env` is read-only on the Mac (chmod 444). Recreate that
# on Linux too — `chmod u+w` briefly when editing, then `chmod u-w`.


# -----------------------------------------------------------------------------
# LLM providers
# -----------------------------------------------------------------------------

# Anthropic — Phase 1/2.5/3 generation, quote verification.
ANTHROPIC_API_KEY=

# A second Anthropic key, kept separate so personal-budget Cerebras
# experiments don't burn shared credits.
PERSONAL_ANTHROPIC=

# Google Gemini — TTS rendering (gemini-2.5-flash-preview-tts and
# gemini-3.1-flash-tts-preview profiles).
GEMINI_API_KEY=

# OpenAI — embeddings (text-embedding-3-large) and the RAG tutorial.
OPENAI_API_KEY=

# Cerebras — alternative generator for the experiments matrix.
CEREBRAS_API_KEY=
CEREBRAS_FREE_TIER_API_KEY=

# OpenAI-compatible serverless providers used by enrichment.llm seam
# (Phase 3, BleakHouse-aun5). Each is read only when a task's
# ModelSpec routes through the corresponding hosting; absent keys
# don't affect Anthropic-default behaviour.
#
# Survey notes in docs/bleakhouse_provider_survey.md; per-host pricing
# in enrichment/llm/cost_table.py.
DEEPINFRA_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
GROQ_API_KEY=
NVIDIA_API_KEY=
NOVITA_API_KEY=
FEATHERLESS_API_KEY=

# Self-hosted vLLM endpoints (Modal / Runpod / GKE). Only set if a
# fallback rehearsal or experimental task routes through them.
MODAL_VLLM_API_KEY=
RUNPOD_VLLM_API_KEY=
GKE_VLLM_API_KEY=


# -----------------------------------------------------------------------------
# Research APIs (optional; only needed for specific experiments)
# -----------------------------------------------------------------------------

GOVINFO_API_KEY=
COURTLISTENER_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
BRAVE_SEARCH_API_KEY=
OPENALEX_API_KEY=


# -----------------------------------------------------------------------------
# Cloudflare R2 — audio object store
# -----------------------------------------------------------------------------
#
# Required for cas.store.{push, pull, has_remote}. The webapp does NOT
# need these (it serves redirects to the public r2.dev URL only).
# Source: Cloudflare dashboard → R2 → API Tokens → existing token, or
# from the project's password store.

R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT_URL=https://667cc18d4aff823066843e08c23a306c.r2.cloudflarestorage.com


# -----------------------------------------------------------------------------
# Local CAS root — per machine
# -----------------------------------------------------------------------------
#
# Where bytes addressed by md5 live locally. If unset, cas/store.py
# defaults to <repo>/data/cas/ (in-tree, gitignored). Pick what suits
# the machine:
#
#   Mac (with external SSD):
#     BLEAKHOUSE_CAS_ROOT=/Volumes/Crucial X9/bleakhouse_audio/cas
#
#   Linux desktop / dev box (separate volume preferred):
#     BLEAKHOUSE_CAS_ROOT=/home/$USER/bleakhouse_cas
#
#   Container deploy (Fly):
#     leave unset — the image bakes JSON only and 302-redirects audio
#     to R2; no local CAS bytes ever land in the container.
#
# Leave commented out to use the in-repo default. The CAS will populate
# itself lazily as you render audio (cas.put on each shard) or pull from
# R2 (uv run python -m scripts.cas_migrate populate --commit).
#
# BLEAKHOUSE_CAS_ROOT=
